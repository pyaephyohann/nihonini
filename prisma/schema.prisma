generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JapaneseLevel {
  N5
  N4
  N3
  N2
  N1
}

enum LearningGoal {
  JLPT
  STUDY
  WORK
  TRAVEL
  LIFE_IN_JAPAN
}

enum PartOfSpeech {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PARTICLE
  EXPRESSION
  OTHER
}

enum ExerciseType {
  MULTIPLE_CHOICE
  FILL_BLANK
  TRANSLATION
  ORDERING
  MATCHING
}

enum LessonCategory {
  VOCABULARY
  GRAMMAR
  KANJI
  READING
  LISTENING
  MIXED
}

enum LessonProgressStatus {
  IN_PROGRESS
  COMPLETED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  passwordHash  String?   @map("password_hash")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts Account[]
  sessions Session[]
  profile  Profile?

  lessonProgresses     UserLessonProgress[]
  vocabularyProgresses UserVocabularyProgress[]
  grammarProgresses    UserGrammarProgress[]
  kanjiProgresses      UserKanjiProgress[]
  readingProgresses    UserReadingProgress[]
  practiceAttempts     PracticeAttempt[]
  readingSubmissions   ReadingSubmission[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Profile {
  id              String         @id @default(cuid())
  userId          String         @unique @map("user_id")
  displayName     String         @map("display_name")
  japaneseLevel   JapaneseLevel  @map("japanese_level")
  targetJlptLevel JapaneseLevel? @map("target_jlpt_level")
  learningGoal    LearningGoal   @map("learning_goal")
  dailyGoal       Int            @default(10) @map("daily_goal")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model JlptLevel {
  id          String        @id @default(cuid())
  code        JapaneseLevel @unique
  name        String
  description String
  order       Int           @unique @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  lessons Lesson[]

  @@map("jlpt_levels")
}

model Lesson {
  id               String         @id @default(cuid())
  title            String
  slug             String         @unique
  description      String
  jlptLevelId      String         @map("jlpt_level_id")
  category         LessonCategory @default(MIXED)
  order            Int            @map("sort_order")
  estimatedMinutes Int            @map("estimated_minutes")
  published        Boolean        @default(false)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  jlptLevel        JlptLevel            @relation(fields: [jlptLevelId], references: [id], onDelete: Cascade)
  vocabularies     LessonVocabulary[]
  grammars         LessonGrammar[]
  kanjiItems       LessonKanji[]
  exercises        Exercise[]
  progresses       UserLessonProgress[]
  practiceAttempts PracticeAttempt[]

  @@unique([jlptLevelId, order])
  @@index([jlptLevelId, published])
  @@index([jlptLevelId, category, published])
  @@map("lessons")
}

model Vocabulary {
  id              String        @id @default(cuid())
  word            String
  reading         String
  meaning         String
  partOfSpeech    PartOfSpeech  @map("part_of_speech")
  jlptLevel       JapaneseLevel @map("jlpt_level")
  difficulty      Int           @default(1)
  exampleSentence String?       @map("example_sentence") @db.Text
  exampleReading  String?       @map("example_reading")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  lessons    LessonVocabulary[]
  kanji      VocabularyKanji[]
  exercises  ExerciseVocabulary[]
  progresses UserVocabularyProgress[]

  @@unique([word, reading])
  @@index([jlptLevel])
  @@map("vocabularies")
}

model Grammar {
  id              String        @id @default(cuid())
  pattern         String
  meaning         String
  explanation     String        @db.Text
  structure       String
  jlptLevel       JapaneseLevel @map("jlpt_level")
  difficulty      Int           @default(1)
  exampleSentence String?       @map("example_sentence") @db.Text
  exampleReading  String?       @map("example_reading")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  lessons    LessonGrammar[]
  exercises  ExerciseGrammar[]
  progresses UserGrammarProgress[]

  @@unique([pattern, meaning])
  @@index([jlptLevel])
  @@map("grammars")
}

model Kanji {
  id          String        @id @default(cuid())
  character   String        @unique
  meaning     String
  onyomi      String
  kunyomi     String
  jlptLevel   JapaneseLevel @map("jlpt_level")
  strokeCount Int           @map("stroke_count")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  lessons    LessonKanji[]
  vocabulary VocabularyKanji[]
  exercises  ExerciseKanji[]
  progresses UserKanjiProgress[]

  @@index([jlptLevel])
  @@map("kanji")
}

model LessonVocabulary {
  id           String @id @default(cuid())
  lessonId     String @map("lesson_id")
  vocabularyId String @map("vocabulary_id")
  order        Int    @map("sort_order")

  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@unique([lessonId, vocabularyId])
  @@unique([lessonId, order])
  @@map("lesson_vocabularies")
}

model LessonGrammar {
  id        String @id @default(cuid())
  lessonId  String @map("lesson_id")
  grammarId String @map("grammar_id")
  order     Int    @map("sort_order")

  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  grammar Grammar @relation(fields: [grammarId], references: [id], onDelete: Cascade)

  @@unique([lessonId, grammarId])
  @@unique([lessonId, order])
  @@map("lesson_grammars")
}

model LessonKanji {
  id       String @id @default(cuid())
  lessonId String @map("lesson_id")
  kanjiId  String @map("kanji_id")
  order    Int    @map("sort_order")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  kanji  Kanji  @relation(fields: [kanjiId], references: [id], onDelete: Cascade)

  @@unique([lessonId, kanjiId])
  @@unique([lessonId, order])
  @@map("lesson_kanji")
}

model VocabularyKanji {
  id           String @id @default(cuid())
  vocabularyId String @map("vocabulary_id")
  kanjiId      String @map("kanji_id")
  order        Int    @map("sort_order")

  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  kanji      Kanji      @relation(fields: [kanjiId], references: [id], onDelete: Cascade)

  @@unique([vocabularyId, kanjiId])
  @@map("vocabulary_kanji")
}

model Exercise {
  id          String       @id @default(cuid())
  lessonId    String       @map("lesson_id")
  type        ExerciseType
  question    String       @db.Text
  explanation String?      @db.Text
  difficulty  Int          @default(1)
  points      Int          @default(10)
  order       Int          @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  lesson            Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  options           ExerciseOption[]
  vocabularyTargets ExerciseVocabulary[]
  grammarTargets    ExerciseGrammar[]
  kanjiTargets      ExerciseKanji[]
  attempts          PracticeAttempt[]

  @@unique([lessonId, order])
  @@index([lessonId])
  @@map("exercises")
}

model ExerciseOption {
  id         String  @id @default(cuid())
  exerciseId String  @map("exercise_id")
  text       String
  isCorrect  Boolean @default(false) @map("is_correct")
  order      Int     @map("sort_order")

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, order])
  @@map("exercise_options")
}

model ExerciseVocabulary {
  id           String @id @default(cuid())
  exerciseId   String @map("exercise_id")
  vocabularyId String @map("vocabulary_id")

  exercise   Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, vocabularyId])
  @@index([vocabularyId])
  @@map("exercise_vocabularies")
}

model ExerciseGrammar {
  id         String @id @default(cuid())
  exerciseId String @map("exercise_id")
  grammarId  String @map("grammar_id")

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  grammar  Grammar  @relation(fields: [grammarId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, grammarId])
  @@index([grammarId])
  @@map("exercise_grammars")
}

model ExerciseKanji {
  id         String @id @default(cuid())
  exerciseId String @map("exercise_id")
  kanjiId    String @map("kanji_id")

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  kanji    Kanji    @relation(fields: [kanjiId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, kanjiId])
  @@index([kanjiId])
  @@map("exercise_kanji")
}

model PracticeAttempt {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  lessonId    String   @map("lesson_id")
  exerciseId  String   @map("exercise_id")
  isCorrect   Boolean  @map("is_correct")
  answer      Json
  timeSpentMs Int?     @map("time_spent_ms")
  createdAt   DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([exerciseId])
  @@index([userId, createdAt])
  @@index([lessonId])
  @@map("practice_attempts")
}

model UserLessonProgress {
  id          String               @id @default(cuid())
  userId      String               @map("user_id")
  lessonId    String               @map("lesson_id")
  status      LessonProgressStatus @default(IN_PROGRESS)
  progress    Float                @default(0)
  score       Float                @default(0)
  startedAt   DateTime             @default(now()) @map("started_at")
  completedAt DateTime?            @map("completed_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([userId, status])
  @@map("user_lesson_progress")
}

model UserVocabularyProgress {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  vocabularyId   String    @map("vocabulary_id")
  correctCount   Int       @default(0) @map("correct_count")
  incorrectCount Int       @default(0) @map("incorrect_count")
  attemptCount   Int       @default(0) @map("attempt_count")
  mastery        Float     @default(0)
  lastReviewedAt DateTime? @map("last_reviewed_at")
  nextReviewAt   DateTime? @map("next_review_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@unique([userId, vocabularyId])
  @@index([userId])
  @@index([userId, nextReviewAt])
  @@map("user_vocabulary_progress")
}

model UserGrammarProgress {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  grammarId      String    @map("grammar_id")
  correctCount   Int       @default(0) @map("correct_count")
  incorrectCount Int       @default(0) @map("incorrect_count")
  attemptCount   Int       @default(0) @map("attempt_count")
  mastery        Float     @default(0)
  lastReviewedAt DateTime? @map("last_reviewed_at")
  nextReviewAt   DateTime? @map("next_review_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  grammar Grammar @relation(fields: [grammarId], references: [id], onDelete: Cascade)

  @@unique([userId, grammarId])
  @@index([userId])
  @@index([userId, nextReviewAt])
  @@map("user_grammar_progress")
}

model UserKanjiProgress {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  kanjiId        String    @map("kanji_id")
  correctCount   Int       @default(0) @map("correct_count")
  incorrectCount Int       @default(0) @map("incorrect_count")
  attemptCount   Int       @default(0) @map("attempt_count")
  mastery        Float     @default(0)
  lastReviewedAt DateTime? @map("last_reviewed_at")
  nextReviewAt   DateTime? @map("next_review_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  kanji Kanji @relation(fields: [kanjiId], references: [id], onDelete: Cascade)

  @@unique([userId, kanjiId])
  @@index([userId])
  @@index([userId, nextReviewAt])
  @@map("user_kanji_progress")
}

model Reading {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  subtitle         String?
  description      String?       @db.Text
  passage          String        @db.Text
  jlptLevel        JapaneseLevel @map("jlpt_level")
  difficulty       Int           @default(1)
  estimatedMinutes Int           @default(3) @map("estimated_minutes")
  order            Int           @map("sort_order")
  published        Boolean       @default(false)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  questions   ReadingQuestion[]
  progresses  UserReadingProgress[]
  submissions ReadingSubmission[]

  @@unique([jlptLevel, order])
  @@index([jlptLevel, published])
  @@map("readings")
}

model ReadingQuestion {
  id          String  @id @default(cuid())
  readingId   String  @map("reading_id")
  question    String  @db.Text
  explanation String? @db.Text
  order       Int     @map("sort_order")

  reading  Reading                 @relation(fields: [readingId], references: [id], onDelete: Cascade)
  options  ReadingQuestionOption[]
  attempts ReadingQuestionAttempt[]

  @@unique([readingId, order])
  @@index([readingId])
  @@map("reading_questions")
}

model ReadingQuestionOption {
  id         String  @id @default(cuid())
  questionId String  @map("question_id")
  text       String
  isCorrect  Boolean @default(false) @map("is_correct")
  order      Int     @map("sort_order")

  question ReadingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, order])
  @@map("reading_question_options")
}

model UserReadingProgress {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  readingId     String    @map("reading_id")
  attemptCount  Int       @default(0) @map("attempt_count")
  completed     Boolean   @default(false)
  bestScore     Float     @default(0) @map("best_score")
  lastScore     Float     @default(0) @map("last_score")
  mastery       Float     @default(0)
  lastAttemptAt DateTime? @map("last_attempt_at")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reading Reading @relation(fields: [readingId], references: [id], onDelete: Cascade)

  @@unique([userId, readingId])
  @@index([userId])
  @@map("user_reading_progress")
}

model ReadingSubmission {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  readingId    String   @map("reading_id")
  correctCount Int      @map("correct_count")
  totalCount   Int      @map("total_count")
  scorePercent Int      @map("score_percent")
  createdAt    DateTime @default(now()) @map("created_at")

  user     User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reading  Reading                  @relation(fields: [readingId], references: [id], onDelete: Cascade)
  attempts ReadingQuestionAttempt[]

  @@index([userId])
  @@index([userId, readingId])
  @@index([userId, createdAt])
  @@map("reading_submissions")
}

model ReadingQuestionAttempt {
  id               String  @id @default(cuid())
  submissionId     String  @map("submission_id")
  questionId       String  @map("question_id")
  selectedOptionId String  @map("selected_option_id")
  isCorrect        Boolean @map("is_correct")

  submission ReadingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   ReadingQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
  @@map("reading_question_attempts")
}
