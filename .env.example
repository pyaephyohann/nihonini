# Nihonini — environment variables
#
# Copy to .env.local for local development. Set the same variables in your
# hosting provider (e.g. Vercel project settings) for production/staging.
#
# All variables below are read by NAME at runtime or build time; no secrets
# are hardcoded anywhere in the repository.

# PostgreSQL connection string (required at runtime and for Prisma CLI).
# Production should use a pooled connection string for serverless (e.g. a
# pgbouncer/Neon/Supabase pooled URL) so Prisma can open many short-lived
# connections from Vercel functions.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Secret used by Auth.js (NextAuth) to sign session JWTs. Generate a strong
# random value, e.g. `openssl rand -base64 32`. Do NOT reuse the local value
# in production.
AUTH_SECRET="your-secret-here"

# --- Tutor (optional feature flag + AI provider) ---
# Set TUTOR_ENABLED to "true" and provide a real API key to enable the Tutor.
# TUTOR_ENABLED and TUTOR_AI_API_KEY are required only if the Tutor feature
# should be active; otherwise the Tutor surfaces a clean "unavailable" state.
TUTOR_ENABLED="false"
TUTOR_AI_API_KEY=""

# Optional Tutor tuning — safe to omit (defaults apply).
TUTOR_AI_MODEL="gpt-4o-mini"
TUTOR_AI_BASE_URL="https://api.openai.com/v1"
TUTOR_AI_MAX_OUTPUT_TOKENS="1024"
TUTOR_AI_TIMEOUT_MS="30000"
TUTOR_AI_MAX_INPUT_CHARS="2000"
